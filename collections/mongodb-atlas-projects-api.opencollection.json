              {
                "name": "groupId",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the project (group)."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a project's settings."
        },
        {
          "info": {
            "name": "Delete a project.",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://cloud.mongodb.com/api/atlas/v2/groups/:groupId",
            "params": [
              {
                "name": "groupId",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the project (group)."
              }
            ]
          },
          "docs": "Delete a project."
